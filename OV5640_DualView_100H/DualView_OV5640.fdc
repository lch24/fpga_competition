###==== BEGIN "Generated Clocks"
create_generated_clock -name {rst_clk} -source [get_ports {clk_p}] [get_pins {u_ddr3_test_h.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {clk_p}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {clk_p}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {clk_p}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
# Board PLL: 27 MHz input; preserve the related PLL clock family.
create_generated_clock -name {pix_clk} -source [get_ports {sys_clk}] [get_pins {u_pll/u_gpll:CLKOUT0}] -multiply_by 11 -divide_by 8
create_generated_clock -name {cfg_clk} -source [get_ports {sys_clk}] [get_pins {u_pll/u_gpll:CLKOUT1}] -multiply_by 77 -divide_by 208
create_generated_clock -name {clk_25M} -source [get_ports {sys_clk}] [get_pins {u_pll/u_gpll:CLKOUT2}] -multiply_by 11 -divide_by 12
# reg_config toggles every 1200 source cycles: full period = 2400 cycles (< 100000 ns).
create_generated_clock -name {cam1_i2c_clk} -source [get_pins {u_pll/u_gpll:CLKOUT2}] [get_nets {comos1_reg_config/clock_20k}] -divide_by 2400
create_generated_clock -name {cam2_i2c_clk} -source [get_pins {u_pll/u_gpll:CLKOUT2}] [get_nets {comos2_reg_config/clock_20k}] -divide_by 2400
# PROVISIONAL 100 MHz camera input timing budget, NOT a measured PCLK frequency.
# Verify against the camera module oscillator/register settings and measurement.
create_clock -name {cmos1_pclk} [get_ports {cmos1_pclk}] -period 10.000 -waveform {0.000 5.000}
create_clock -name {cmos2_pclk} [get_ports {cmos2_pclk}] -period 10.000 -waveform {0.000 5.000}
# OV5640 0x4740=0x20 preserves the original board's polarity; bit1 is not inverted.
# FPGA captures DVP data and sync at the rising PCLK edge (bit5 unchanged).
# DVP bytes change around the opposite (falling) PCLK edge. Use that launch
# edge here: rising-to-rising delays incorrectly give the input FF a whole
# period of setup time instead of half a period. VSYNC/data/HREF are sampled
# by the same single-register input stage; no pin feeds pixel control directly.
# Provisional board+sensor delay budget 0..3 ns; confirm on the actual module.
set_input_delay -clock {cmos1_pclk} -clock_fall -max 3.0 [get_ports {cmos1_data[*] cmos1_href cmos1_vsync}]
set_input_delay -clock {cmos1_pclk} -clock_fall -min 0.0 [get_ports {cmos1_data[*] cmos1_href cmos1_vsync}]
set_input_delay -clock {cmos2_pclk} -clock_fall -max 3.0 [get_ports {cmos2_data[*] cmos2_href cmos2_vsync}]
set_input_delay -clock {cmos2_pclk} -clock_fall -min 0.0 [get_ports {cmos2_data[*] cmos2_href cmos2_vsync}]
# Realtime camera/HDMI FIFOs: do NOT globally false-path camera <-> DDR or
# pixel <-> DDR. That would hide the Gray-pointer bit-skew requirement.
# A <=8ns datapath bound is shorter than either endpoint period (camera PCLK
# provisional 10ns, DDR 8ns). Only asynchronous hold relations are cut.
# First-stage synchronizers and dual-clock RAM still require physical review.
set_clock_groups -name camera_inputs_independent -asynchronous -group [get_clocks {cmos1_pclk}] -group [get_clocks {cmos2_pclk}]
set_max_delay -datapath_only 8.0 -from [get_clocks {cmos1_pclk cmos2_pclk}] -to [get_clocks {ddrphy_sysclk}]
set_max_delay -datapath_only 8.0 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {cmos1_pclk cmos2_pclk}]
set_false_path -hold -from [get_clocks {cmos1_pclk cmos2_pclk}] -to [get_clocks {ddrphy_sysclk}]
set_false_path -hold -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {cmos1_pclk cmos2_pclk}]
set_max_delay -datapath_only 8.0 -from [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_i2c_clk cam2_i2c_clk}] -to [get_clocks {ddrphy_sysclk}]
set_max_delay -datapath_only 8.0 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_i2c_clk cam2_i2c_clk}]
set_false_path -hold -from [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_i2c_clk cam2_i2c_clk}] -to [get_clocks {ddrphy_sysclk}]
set_false_path -hold -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_i2c_clk cam2_i2c_clk}]
# Camera frame-count debug snapshots also use a held bundled-data handshake.
set_max_delay -datapath_only 8.0 -from [get_clocks {cmos1_pclk cmos2_pclk}] -to [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_i2c_clk cam2_i2c_clk}]
set_max_delay -datapath_only 8.0 -from [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_i2c_clk cam2_i2c_clk}] -to [get_clocks {cmos1_pclk cmos2_pclk}]
set_false_path -hold -from [get_clocks {cmos1_pclk cmos2_pclk}] -to [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_i2c_clk cam2_i2c_clk}]
set_false_path -hold -from [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_i2c_clk cam2_i2c_clk}] -to [get_clocks {cmos1_pclk cmos2_pclk}]
# The 10 kHz I2C register-config clocks are a /2400 division of clk_25M, so the
# tool would otherwise time them as synchronous against the fast board clocks and
# report a meaningless multi-nanosecond path between two unrelated logical
# periods. The only signals leaving that domain are the two reg_conf_done flags,
# which are consumed by a proper PAP_ASYNC_REG synchronizer (ready_sync) and by
# the debug health word, so this crossing is a CDC rather than a timed path.
set_false_path -from [get_clocks {cam1_i2c_clk cam2_i2c_clk}] -to [get_clocks {sys_clk pix_clk cfg_clk clk_25M}]
set_false_path -from [get_clocks {sys_clk pix_clk cfg_clk clk_25M}] -to [get_clocks {cam1_i2c_clk cam2_i2c_clk}]
# cfg_clk is the PLL's x77/208 (10 MHz) generation of sys_clk. The only signals
# leaving that domain are the ms72xx HDMI-config status bits, which reach the
# sys_clk debug health word through its PAP_ASYNC_REG synchronizer. The tool
# otherwise checks that level crossing against a single PLL-derivative edge and
# reports a meaningless violation (worst reported setup slack, on
# diagnostics/hs1[5]); bound the datapath instead of the edge relationship.
set_max_delay -datapath_only 8.0 -from [get_clocks {cfg_clk}] -to [get_clocks {sys_clk}]
set_false_path -hold -from [get_clocks {cfg_clk}] -to [get_clocks {sys_clk}]
###==== END "Generated Clocks"

