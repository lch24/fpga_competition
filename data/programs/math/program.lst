exp:
  FROMFP   2, 0, 0, 0
  MOV      3, 2, 0, 0
  BR       1, 2, 0, 0
  ADD      3, 3, 22, 0
  BR       0, 0, 0, 0
exp_negative:
  SUB      3, 3, 22, 0
exp_reduce:
  DIVI     3, 3, 18, 0
  SETSCALE 0, 3, 0, 0
  MULI     4, 3, 18, 0
  SUB      2, 2, 4, 0
  MOV      3, 17, 0, 0
  MOV      4, 17, 0, 0
  SETI     1, 32, 1
exp_loop:
  MULQ     3, 3, 2, 0
  GETI     5, 0, 0, 0
  DIVI     3, 3, 5, 0
  ADD      4, 4, 3, 0
  LOOP     0, 0, 0, 0
  RET      0, 4, 0, 1
log:
  UNPACK   2, 0, 0, 0
  GETSCALE 6, 0, 0, 0
  SUB      3, 2, 17, 0
  ADD      4, 2, 17, 0
  DIVQ     2, 3, 4, 0
  MULQ     3, 2, 2, 0
  MOV      4, 2, 0, 0
  MOV      5, 2, 0, 0
  SETI     3, 79, 2
log_loop:
  MULQ     4, 4, 3, 0
  GETI     7, 0, 0, 0
  DIVI     7, 4, 7, 0
  ADD      5, 5, 7, 0
  LOOP     0, 0, 0, 0
  MULI     6, 6, 18, 0
  SHL      5, 5, 0, 0
  ADD      5, 5, 6, 0
  SETSCALE 0, 16, 0, 0
  RET      0, 5, 0, 1
log_near:
  FP       2, 0, 23, 1
  FP       3, 0, 23, 0
  FP       2, 2, 3, 3
  FP       3, 2, 2, 2
  FP       3, 3, 2, 2
  FP       3, 3, 25, 3
  FP       3, 2, 3, 0
  FP       3, 3, 24, 2
