trig:
  RANGE    2, 0, 0, 0
  MULQ     2, 2, 19, 0
  MOV      0, 21, 0, 0
  MOV      1, 16, 0, 0
  SETI     0, 127, 1
rotate:
  TEST     0, 2, 0, 0
  SAR      3, 1, 0, 1
  SAR      4, 0, 0, 1
  ANGLE    5, 0, 0, 0
  SUBC     0, 0, 3, 0
  ADDC     1, 1, 4, 0
  SUBC     2, 2, 5, 0
  LOOP     0, 0, 0, 0
  SELECT   2, 0, 1, 0
  SETSCALE 0, 16, 0, 0
