acos:
  FP       2, 23, 0, 1
  FP       3, 23, 0, 0
  FP       2, 2, 3, 2
  FP       2, 2, 16, 4
  MOV      1, 0, 0, 0
  MOV      0, 2, 0, 0
atan:
  ATEST    0, 0, 1, 0
  UNPACK   2, 0, 0, 0
  GETSCALE 4, 0, 0, 0
  UNPACK   3, 1, 0, 0
  GETSCALE 5, 0, 0, 0
  SUB      6, 4, 5, 0
  BR       7, 0, 0, 0
  ADD      7, 6, 26, 0
  BR       1, 7, 0, 0
atan_align:
  BR       1, 6, 0, 0
  SAR      3, 3, 6, 0
  BR       0, 0, 0, 0
atan_y_small:
  NEG      6, 6, 0, 0
  SAR      2, 2, 6, 0
atan_aligned:
  MOV      0, 3, 0, 0
  MOV      1, 2, 0, 0
  MOV      2, 16, 0, 0
  SETI     0, 127, 1
vector:
  TEST     0, 1, 0, 1
  SAR      3, 1, 0, 1
  SAR      4, 0, 0, 1
  ANGLE    5, 0, 0, 0
  ADDC     0, 0, 3, 0
  SUBC     1, 1, 4, 0
